# The CRM service, with the /api/v1 path and no trailing slash. Inlined at BUILD time.
VITE_API_URL=http://localhost:4008/api/v1

# Where to send somebody who is not signed in: CRM has no login screen of its own, Inventory's
# sign-in sets the cookie both apps read.
VITE_INVENTORY_URL=http://localhost:5173
